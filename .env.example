# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# !! CHANGE BEFORE DEPLOYING ANYWHERE PUBLIC !!
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database — defaults to SQLite when unset. For Supabase (PostgreSQL), copy
# this file to .env and fill the values from:
#   Supabase Dashboard → Project Settings → Database → Connection string
#   Direct connection (IPv6-only on the free tier): db.<ref>.supabase.co / 5432,
#                                                   user postgres
#   Session pooler (IPv4-friendly):                 <ref>.pooler.supabase.com /
#                                                   6543, user postgres.<ref>
# The password is a secret — put it ONLY in your .env (gitignored), never here.
# settings.py expands the short engine name and adds sslmode=require itself.
# ---------------------------------------------------------------------------
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=postgres
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=db.<your-project-ref>.supabase.co
DJANGO_DB_PORT=5432
DJANGO_DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Razorpay (https://dashboard.razorpay.com/app/keys)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret created in Dashboard → Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=
# Public base URL the webhook is reachable at, e.g. https://ngo.example.com
RAZORPAY_WEBHOOK_BASE_URL=

# ---------------------------------------------------------------------------
# Donations
# ---------------------------------------------------------------------------
DONATION_CURRENCY=INR
# From-address for automated acknowledgement emails.
DONATION_ACK_FROM_EMAIL=noreply@example.org